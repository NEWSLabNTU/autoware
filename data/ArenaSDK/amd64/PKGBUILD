pkgname=arena-sdk
pkgver=0.1.91
pkgrel=1
pkgdesc='Arena SDK for LUCID cameras'
arch=(amd64)
depends=(libibverbs1 librdmacm1)
license=()
url='https://thinklucid.com/arena-software-development-kit/'

source=(
    "ArenaSDK_v${pkgver}_Linux_x64.tar.gz"
    Arena_SDK.conf
)
sha256sums=(
    0de7d1d5f3d0b35e2ad6766d1d839fbe21473638db14715a86a79be53ef54117
    b96f9eb0b6d1e84c09fa00b12cf886022df111fac4976a7b0493fae5e379eec3
)

package() {
    install -dm755 "$pkgdir/opt"
    cp -r "$srcdir/ArenaSDK_Linux_x64" "$pkgdir/opt/ArenaSDK"
    install -Dm644 "$srcdir/README" "$pkgdir/opt/ArenaSDK/README"
    install -Dm644 "$srcdir/Arena_SDK.conf" "$pkgdir/etc/ld.so.conf.d/Arena_SDK.conf"
}
