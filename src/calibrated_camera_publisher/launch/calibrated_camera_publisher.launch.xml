<launch>
  <arg name="launch_driver" default="true" />

  <group>
    <push-ros-namespace namespace="camera" />

    <include file="$(find-pkg-share lucid_vision_driver)/launch/test_node_container.launch.py">
    </include>

    <node pkg="calibrated_camera_publisher" exec="camera_info_publisher" output="screen">
    </node>

    <node pkg="image_proc" exec="image_proc" output="screen">
	    <remap from="/camera/image" to="/lucid_vision/camera_1/image"/>
    </node>

  </group>
</launch>
